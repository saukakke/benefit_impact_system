Options -Indexes
RewriteEngine On

<FilesMatch "^(?:\.env(?:\..*)?|.*\.(?:sql|log|ini|bak|conf|dist|example))$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L]

RewriteRule ^storage/uploads/.*\.(?:php|phtml|phar|cgi|pl|py|sh)$ - [F,L,NC]
